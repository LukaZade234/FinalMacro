# data/ is local-only and holds Discord tokens. Ignore the whole tree rather
# than naming files: per-file rules missed timestamped backups
# (settings.json.bak-<stamp>) and Syncthing conflict copies, which put real
# tokens into a commit. Only the .gitkeep placeholders are tracked.
data/**
!data/.gitkeep
!data/session_logs/
!data/session_logs/.gitkeep



# Live Mudae command capture (local machine only — contains server-specific text)
docs/archive/MUDAE_SETTINGS_COMMANDS.md

# Minigame log exports used to validate the solvers. Same reason as data/:
# they carry guild / channel ids and names. Keep them local; the solvers read
# them through `--from-log`, nothing needs them in the repo.
docs/minigames_to_use.jsonl
docs/*_log.json
docs/*_log.jsonl

# Claude Code local state (scheduled_tasks.lock and friends). Nothing here is
# shared config today — if project-wide skills/agents/settings are ever added
# under .claude/, un-ignore those specific paths so they do get committed.
.claude/

.venv/
__pycache__/
*.pyc
.pytest_cache/
