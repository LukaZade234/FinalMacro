# data/ is local-only and holds Discord tokens. Ignore the whole tree rather
# than naming files: per-file rules missed timestamped backups
# (settings.json.bak-<stamp>) and Syncthing conflict copies, which put real
# tokens into a commit. Only the .gitkeep placeholders are tracked.
data/**
!data/.gitkeep
!data/session_logs/
!data/session_logs/.gitkeep



# Live Mudae command capture (local machine only — contains server-specific text)
docs/archive/MUDAE_SETTINGS_COMMANDS.md

.venv/
__pycache__/
*.pyc
.pytest_cache/
